<h3>{{viewTitle}}</h3>
<form action='/' method='POST' autocomplete='off'>
	<input type='hidden' name='_id' value='{{student._id}}' />
	<div class='form-group'>
		<label>Full Name</label>
		<input
			type='text'
			class='form-control'
			name='fullName'
			placeholder='Full Name'
			required
			value='{{student.fullName}}'
		/>
	</div>
	<div class='form-group'>
		<label>Email</label>
		<input type='email' class='form-control' name='email' placeholder='Email' required value='{{student.email}}' />
	</div>
	<div class='form-row'>
		<div class='form-group col-md-6'>
			<label>Mobile</label>
			<input
				type='tel'
				class='form-control'
				name='mobile'
				placeholder='Mobile'
				required
				minlength='9'
				maxlength='9'
				pattern='[0-9]{9}'
				title='Numer telefonu musi składać się z dokładnie 9 cyfr'
				value='{{student.mobile}}'
			/>
		</div>
		<div class='form-group col-md-6'>
			<label>City</label>
			<input type='text' class='form-control' name='city' placeholder='City' required value='{{student.city}}' />
		</div>
	</div>
	<div class='form-group'>
		<button type='submit' class='btn btn-info'>Submit</button>
		<a class='btn btn-secondary' href='/list'>View All</a>
	</div>
</form>